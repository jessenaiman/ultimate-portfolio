---
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '../table';

interface PropData {
  name: string;
  type: string;
  default?: string;
  description: string;
}

interface Props {
  data: PropData[];
  title?: string;
}

const {
  data,
  title = "Props"
} = Astro.props;
---

<div class="mt-12">
  <h2 class="text-xl font-semibold text-foreground mb-6">{title}</h2>
  <div class="overflow-x-auto">
    <Table>
      <TableHeader>
        <TableRow>
          <TableHead className="w-[120px]">Property</TableHead>
          <TableHead className="w-[100px]">Type</TableHead>
          <TableHead className="w-[80px]">Default</TableHead>
          <TableHead>Description</TableHead>
        </TableRow>
      </TableHeader>
      <TableBody>
        {data.map((prop, index) => (
          <TableRow key={prop.name} className={index % 2 === 0 ? 'bg-muted/50' : ''}>
            <TableCell className="font-medium">
              <code class="bg-muted px-2 py-1 rounded text-sm">{prop.name}</code>
            </TableCell>
            <TableCell>
              <code class="text-muted-foreground text-sm">{prop.type}</code>
            </TableCell>
            <TableCell>
              {prop.default ? (
                <code class="bg-muted px-2 py-1 rounded text-sm">{prop.default}</code>
              ) : (
                <span class="text-muted-foreground">—</span>
              )}
            </TableCell>
            <TableCell className="text-sm text-muted-foreground">{prop.description}</TableCell>
          </TableRow>
        ))}
      </TableBody>
    </Table>
  </div>
</div>