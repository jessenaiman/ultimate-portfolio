---
import { Slider } from '../slider';
import { Label } from '../label';

interface Props {
  title: string;
  min?: number;
  max?: number;
  step?: number;
  value: number;
  valueUnit?: string;
  width?: string;
  isDisabled?: boolean;
}

const {
  title,
  min = 0,
  max = 100,
  step = 1,
  value,
  valueUnit = "",
  width = "w-[150px]",
  isDisabled = false
} = Astro.props;
---

<div class="flex items-center gap-4 py-4">
  <Label className="text-sm font-medium">{title}</Label>
  <Slider
    min={min}
    max={max}
    step={step}
    value={[value]}
    disabled={isDisabled}
    className={width}
  />
  <span class="text-sm text-muted-foreground font-mono">
    {value}{valueUnit}
  </span>
</div>