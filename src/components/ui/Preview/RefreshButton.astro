---
import { Button } from '../button';
import { RefreshCw } from 'lucide-react';

interface Props {
  onClick?: () => void;
}

const { onClick } = Astro.props;
---

<Button
  variant="outline"
  size="icon"
  onClick={onClick}
  className="absolute top-3 right-3 z-10 bg-background/80 backdrop-blur-sm border-border hover:bg-accent transition-colors"
>
  <RefreshCw className="h-4 w-4" />
</Button>