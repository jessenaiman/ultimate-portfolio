---
import { Switch } from '../switch';
import { Label } from '../label';

interface Props {
  title: string;
  isChecked: boolean;
  isDisabled?: boolean;
}

const {
  title,
  isChecked,
  isDisabled = false
} = Astro.props;
---

<div class="flex items-center gap-4 py-4">
  <Label className="text-sm font-medium">{title}</Label>
  <Switch
    checked={isChecked}
    disabled={isDisabled}
  />
</div>