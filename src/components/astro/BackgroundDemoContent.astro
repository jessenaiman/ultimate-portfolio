---
interface Props {
  children?: any;
  className?: string;
}

const { children, className = "" } = Astro.props;
---

<div class={`bg-background border border-border rounded-lg p-6 ${className}`}>
  <div class="text-center">
    <h3 class="text-lg font-semibold text-foreground mb-2">Background Demo</h3>
    <p class="text-muted-foreground text-sm mb-4">
      This area demonstrates background effects and styling
    </p>
    {children}
  </div>
</div>