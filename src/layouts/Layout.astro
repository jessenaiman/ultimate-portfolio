---
/**
 * Base layout
 *
 * Rationale:
 * - Removed structural control props (showHeader, showFooter, fullWidth) to avoid duplicating Tailwind utility intent.
 * - Pages now control width / padding themselves (apply container / max-w-* where needed).
 * - Only SEO-related props (title, description) remain.
 * - ThemeProvider (next-themes) mounted once to supply shadcn/ui theme context & system preference handling.
 *
 * If a page requires a chrome‑less view, introduce a separate minimal layout instead of adding conditional props here.
 */
import Head from "../components/astro/Head.astro";
import Navbar from "../components/astro/Navbar.astro";
import Footer from "../components/astro/Footer.astro";
import "../styles/global.css";

const {
  title,
  description = "Professional web development portfolio showcasing modern frameworks and best practices",
} = Astro.props;
---

<html lang="en" class="scroll-smooth">
  <Head title={title} description={description}>
    <script is:inline>
	const getThemePreference = () => {
		if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
			return localStorage.getItem('theme');
		}
		return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
	};
	const isDark = getThemePreference() === 'dark';
	document.documentElement.classList[isDark ? 'add' : 'remove']('dark');

	if (typeof localStorage !== 'undefined') {
		const observer = new MutationObserver(() => {
			const isDark = document.documentElement.classList.contains('dark');
			localStorage.setItem('theme', isDark ? 'dark' : 'light');
		});
		observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
	}
</script>
    <slot name="head" />
  </Head>

  <body class="min-h-dvh flex flex-col bg-background text-foreground antialiased font-sans scroll-smooth">
    <!-- Theme + Navigation -->
    <header class="sticky top-0 z-50 border-b bg-background/80 backdrop-blur-sm">
      <Navbar />
    </header>

    <!-- Main content (pages decide their own inner width strategy) -->
    <main class="flex-1">
      <div class="px-4 sm:px-6 lg:px-8 py-6">
        <slot />
      </div>
    </main>

    <footer class="border-t">
      <Footer />
    </footer>
  </body>
</html>
