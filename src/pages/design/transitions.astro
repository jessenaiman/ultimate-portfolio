---
import Layout from '../../layouts/Layout.astro';
import Preview from '../../components/astro/Preview.astro';
import TransitionsDemo from '../../components/react/preview/TransitionsDemo';
import DemoBox from '../../components/react/preview/DemoBox';

// CSS styles for the demo boxes
const demoBoxStyles = `
.demo-box {
  width: 100px;
  height: 100px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 0.875rem;
  line-height: 1.25rem;
  font-weight: 600;
  color: white;
  border-radius: 0.5rem;
  transition: all 0.3s ease;
}
`;
---

<Layout title="Tailwind CSS Transitions & Effects">
  <style>{demoBoxStyles}</style>

  <div class="container mx-auto p-8">
    <h1 class="text-4xl font-bold text-center text-foreground mb-8">Tailwind CSS Transitions & Effects</h1>

    <!-- Transitions Section -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold text-foreground mb-6">Transitions</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- Transition All -->
        <Preview title="Transition All" description="Applies transitions to all properties">
          <TransitionsDemo
            title="Transition All"
            initialDemo={
              <DemoBox className="bg-blue-500 hover:bg-red-500 hover:scale-110">
                transition-all
              </DemoBox>
            }
            controls={[
              {
                controlType: 'slider',
                title: 'Duration',
                min: 100,
                max: 1000,
                step: 50,
                initialValue: 300,
                onChange: (value) => {
                  // This would update CSS custom properties or classes
                  console.log('Duration changed to:', value);
                }
              }
            ]}
          />
        </Preview>

        <!-- Transition Colors -->
        <Preview title="Transition Colors" description="Smooth color transitions">
          <TransitionsDemo
            title="Transition Colors"
            initialDemo={
              <DemoBox className="bg-green-500 hover:bg-yellow-500">
                transition-colors
              </DemoBox>
            }
            controls={[
              {
                controlType: 'slider',
                title: 'Duration',
                min: 100,
                max: 1000,
                step: 50,
                initialValue: 300,
                onChange: (value) => {
                  console.log('Color duration changed to:', value);
                }
              }
            ]}
          />
        </Preview>

        <!-- Transition Opacity -->
        <Preview title="Transition Opacity" description="Fade in/out transitions">
          <TransitionsDemo
            title="Transition Opacity"
            initialDemo={
              <DemoBox className="bg-purple-500 hover:opacity-50">
                transition-opacity
              </DemoBox>
            }
            controls={[
              {
                controlType: 'slider',
                title: 'Duration',
                min: 100,
                max: 1000,
                step: 50,
                initialValue: 300,
                onChange: (value) => {
                  console.log('Opacity duration changed to:', value);
                }
              }
            ]}
          />
        </Preview>

      </div>
    </section>

    <!-- Timing Functions Section -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold text-foreground mb-6">Timing Functions</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Ease Linear -->
        <Preview title="Ease Linear" description="Linear animation timing">
          <TransitionsDemo
            title="Ease Linear"
            initialDemo={
              <DemoBox className="bg-teal-500 hover:translate-x-10">
                ease-linear
              </DemoBox>
            }
            controls={[
              {
                controlType: 'select',
                title: 'Timing Function',
                options: [
                  { label: 'ease-linear', value: 'ease-linear' },
                  { label: 'ease-in', value: 'ease-in' },
                  { label: 'ease-out', value: 'ease-out' },
                  { label: 'ease-in-out', value: 'ease-in-out' }
                ],
                initialValue: 'ease-linear',
                onChange: (value) => {
                  console.log('Timing function changed to:', value);
                }
              }
            ]}
          />
        </Preview>

        <!-- Ease In -->
        <Preview title="Ease In" description="Slow start timing">
          <TransitionsDemo
            title="Ease In"
            initialDemo={
              <DemoBox className="bg-teal-500 hover:translate-x-10">
                ease-in
              </DemoBox>
            }
            controls={[
              {
                controlType: 'select',
                title: 'Timing Function',
                options: [
                  { label: 'ease-linear', value: 'ease-linear' },
                  { label: 'ease-in', value: 'ease-in' },
                  { label: 'ease-out', value: 'ease-out' },
                  { label: 'ease-in-out', value: 'ease-in-out' }
                ],
                initialValue: 'ease-in',
                onChange: (value) => {
                  console.log('Timing function changed to:', value);
                }
              }
            ]}
          />
        </Preview>

      </div>
    </section>

    <!-- Animations Section -->
    <section>
      <h2 class="text-2xl font-semibold text-foreground mb-6">Animations</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Spin -->
        <Preview title="Spin" description="Continuous spinning animation">
          <TransitionsDemo
            title="Spin"
            initialDemo={
              <DemoBox className="bg-gray-700 animate-spin">
                animate-spin
              </DemoBox>
            }
            controls={[
              {
                controlType: 'switch',
                title: 'Enable Animation',
                initialValue: true,
                onChange: (value) => {
                  console.log('Animation enabled:', value);
                }
              }
            ]}
          />
        </Preview>

        <!-- Pulse -->
        <Preview title="Pulse" description="Opacity pulsing animation">
          <TransitionsDemo
            title="Pulse"
            initialDemo={
              <DemoBox className="bg-gray-700 animate-pulse">
                animate-pulse
              </DemoBox>
            }
            controls={[
              {
                controlType: 'switch',
                title: 'Enable Animation',
                initialValue: true,
                onChange: (value) => {
                  console.log('Animation enabled:', value);
                }
              }
            ]}
          />
        </Preview>

      </div>
    </section>

  </div>
</Layout>
